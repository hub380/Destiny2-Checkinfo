{
  "name": "destiny2-fireteam-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "frontend:dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "gear:index": "node scripts/build-gear-index.js",
    "gear:publish-r2": "node scripts/gear-publish-r2.js",
    "activity:index": "node scripts/build-activity-index.js",
    "guides:validate": "node scripts/guides-validate.js",
    "guides:upload": "node scripts/guides-upload.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
