{
  "name": "destiny2-checkinfo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run api:dev\" \"npm run frontend:dev\"",
    "api:dev": "cross-env PORT=5174 node server/index.js",
    "frontend:dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/frontend.test.js tests/lib.test.js tests/url.test.js tests/gear-split.test.js tests/gear-cache.test.js",
    "test:sit": "vitest run tests/app.test.js",
    "test:watch": "vitest",
    "gear:index": "node scripts/data/build-gear-index.js",
    "gear:publish-r2": "node scripts/gear/publish-r2.js",
    "activity:index": "node scripts/data/build-activity-index.js",
    "indexes:rebuild": "npm run gear:index && npm run activity:index",
    "indexes:validate": "npm run guides:validate",
    "guides:validate": "node scripts/guides/validate.js",
    "guides:upload": "node scripts/guides/upload.js",
    "codegen:destiny": "node scripts/codegen/split-destiny.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "npm run build && node scripts/data/prune-dist-gear.js && wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.7.0",
    "jsdom": "^26.0.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.8",
    "wrangler": "^4.104.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.3",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~5.8.3",
    "vite": "^8.0.16"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
