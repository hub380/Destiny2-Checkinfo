# Web server
PORT=5173

# Bungie API
BUNGIE_API_KEY=replace_with_your_bungie_api_key
BUNGIE_MEMBERSHIP_TYPE=-1
BUNGIE_LOCALE=zh-chs

# Heybox (小黑盒) team source — code identifiers use `heybox`, UI shows 小黑盒
HEYBOX_SOURCE_URL=https://api.xiaoheihe.cn/game/common_team_v2/home?appid=1085660
HEYBOX_SOURCE_METHOD=GET
HEYBOX_SOURCE_HEADERS={"accept":"application/json,text/html;q=0.9","user-agent":"Mozilla/5.0 Destiny2Checkinfo/1.0"}
HEYBOX_SOURCE_BODY=
HEYBOX_ITEM_URL_PATTERN=
HEYBOX_MAX_BYTES=2000000

# Request limits
REQUEST_TIMEOUT_MS=15000
DETAILS_PROFILE_TIMEOUT_MS=45000
BUNGIE_MAX_BYTES=20000000

# Cache TTL (seconds)
CAREER_CACHE_TTL_SECONDS=900
SUMMARY_CACHE_TTL_SECONDS=300
ENDGAME_CACHE_TTL_SECONDS=900
PLAYER_SEARCH_CACHE_TTL_SECONDS=300
ACTIVITY_DEFINITION_CACHE_TTL_SECONDS=31536000
GEAR_INDEX_CACHE_TTL_SECONDS=604800
GEAR_CACHE_STATUS_TTL_SECONDS=604800
GUIDE_INDEX_CACHE_TTL_SECONDS=300

# History pagination
ENDGAME_HISTORY_PAGE_LIMIT=10
ENDGAME_HISTORY_PAGE_SIZE=250
PVP_HISTORY_PAGE_LIMIT=20
PVP_HISTORY_PAGE_SIZE=250
PLAYER_SEARCH_MAX_PAGES=4

# Concurrency / timeouts
ACTIVITY_DEFINITION_CONCURRENCY=4
FIRETEAM_MEMBER_CONCURRENCY=2
FIRETEAM_TRANSITORY_TIMEOUT_MS=3500
GEAR_MANIFEST_MAX_BYTES=80000000
GEAR_MANIFEST_TIMEOUT_MS=30000
GEAR_CACHE_CHECK_TIMEOUT_MS=10000
GEAR_INDEX_BUILD_MAX_BYTES=500000000

# Cloudflare (R2 publish via wrangler — use login OR API token)
# CLOUDFLARE_API_TOKEN=replace_with_token_that_has_r2_edit
# npm run gear:publish-r2
# GEAR_CACHE_FORCE=1          # re-upload even if manifest unchanged
# GEAR_CACHE_WRITE_KV=1       # also write gear-cache:latest pointer to KV
# npm run indexes:rebuild   # gear + activity
# npm run indexes:validate  # guides content
# GEAR_MANIFEST_TIMEOUT_MS=120000  # use if manifest download times out
R2_SNAPSHOT_PREFIX=career-snapshots
R2_GUIDE_PREFIX=guides
R2_GEAR_PREFIX=gear-cache/v2
R2_BUCKET=destiny2-checkinfo-data
